<?xml version="1.0" encoding="UTF-8" ?>
<extension version="2.5" type="plugin" group="vmpayment" method="upgrade">
	<name>Payneteasy payment</name>
	<creationDate>March 2026</creationDate>
	<author>Payneteasy</author>
	<authorUrl>https://payneteasy.com/</authorUrl>
	<copyright>Copyright (C) 2026 Payneteasy. All rights reserved.</copyright>
	<license>Property of Payneteasy</license>
	<version>1.1.0</version>
	<description>Payneteasy payment plugin for VirtueMart</description>

	<files>
		<filename plugin="payneteasy">payneteasy.php</filename>
		<filename>Payneteasy.lib.php</filename>
		<filename>install.php</filename>
		<folder>assets</folder>
		<folder>fields</folder>
		<folder>language</folder>
		<folder>tmpl</folder>
	</files>

	<scriptfile>install.php</scriptfile>

	<languages>
		<language tag="en-GB">language/en-GB/en-GB.plg_vmpayment_payneteasy.ini</language>
	</languages>

	<vmconfig>
		<fields name="params">
			<fieldset name="api" addfieldpath="/plugins/vmpayment/payneteasy/fields">
				<field type="pneassets"/>
				<field name="IS_LIVE" type="pnefield" fieldtype="checkbox" label="PAYNETEASY_IS_LIVE"/>
				<field name="IS_MULTICURR" type="pnefield" fieldtype="checkbox" label="PAYNETEASY_IS_MULTICURR"/>

				<field name="SANDBOX_URL" type="pnefield" fieldtype="text" label="PAYNETEASY_SANDBOX_URL" required="true"/>
				<field name="SANDBOX_END_POINT" type="pnefield" fieldtype="text" label="PAYNETEASY_SANDBOX_END_POINT" required="true"/>
				<field name="SANDBOX_LOGIN" type="pnefield" fieldtype="text" label="PAYNETEASY_SANDBOX_LOGIN" required="true"/>
				<field name="SANDBOX_CONTROL_KEY" type="pnefield" fieldtype="text" label="PAYNETEASY_SANDBOX_CONTROL_KEY" required="true"/>

				<field name="LIVE_URL" type="pnefield" fieldtype="text" label="PAYNETEASY_LIVE_URL" required="true"/>
				<field name="LIVE_END_POINT" type="pnefield" fieldtype="text" label="PAYNETEASY_LIVE_END_POINT" required="true"/>
				<field name="LIVE_LOGIN" type="pnefield" fieldtype="text" label="PAYNETEASY_LIVE_LOGIN" required="true"/>
				<field name="LIVE_CONTROL_KEY" type="pnefield" fieldtype="text" label="PAYNETEASY_LIVE_CONTROL_KEY" required="true"/>

				<field name="IS_FORM" type="pnefield" fieldtype="checkbox" label="PAYNETEASY_IS_FORM"/>
			</fieldset>
		</fields>
	</vmconfig>

	<updateservers>
		<server type="extension" name="PayNetEasy Update Site"><![CDATA[https://raw.githubusercontent.com/payneteasy/php-plugin-joomla-2/refs/heads/master/installation/update.xml]]></server>
	</updateservers>
</extension>
